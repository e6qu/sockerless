[[label]]
name                       = "sockerless-cloudrun"
gcp_project                = "sockerless-live-46x3zg4imo"
gcp_region                 = "us-central1"
image                      = "us-central1-docker.pkg.dev/sockerless-live-46x3zg4imo/sockerless-live/runner:cloudrun-amd64"
service_account            = "sockerless-runner@sockerless-live-46x3zg4imo.iam.gserviceaccount.com"
runner_workspace_bucket    = "sockerless-live-46x3zg4imo-runner-workspace"
# "gcs-sync" leaves the runner-task tmpfs and propagates the workspace
# via the GCS SDK at exec boundaries. Required when bucket is set.
# "gcs-fuse" is the legacy direct-mount mode (tar-pack persist).
runner_workspace_backing   = "gcs-sync"
# Cloud Run task timeout on the runner-task (seconds). Default 3600;
# GitHub allows jobs up to 6h — raise for long pipelines.
runner_job_timeout         = 3600
# Cap on live runner Jobs in this (project, region). 0 = unbounded.
max_concurrent             = 10

[[label]]
name                       = "sockerless-gcf"
gcp_project                = "sockerless-live-46x3zg4imo"
gcp_region                 = "us-central1"
image                      = "us-central1-docker.pkg.dev/sockerless-live-46x3zg4imo/sockerless-live/runner:gcf-amd64"
service_account            = "sockerless-runner@sockerless-live-46x3zg4imo.iam.gserviceaccount.com"
runner_workspace_bucket    = "sockerless-live-46x3zg4imo-runner-workspace"
runner_workspace_backing   = "gcs-sync"
