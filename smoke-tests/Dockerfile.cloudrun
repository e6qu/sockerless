FROM golang:1.25

# The v0.2.0 release commit; go install of a subdirectory module needs a
# commit-ish, not the repository-root release tag.
ARG SOCKERLESS_CLOUD_VERSION=723736a8a233e0f3ccb3d6ce0c209a94bfc9afc2

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && ARCH=$(uname -m) \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${ARCH}/docker-27.5.1.tgz" | tar xz -C /usr/local/bin --strip-components=1 docker/docker

# Resilient module-download wrappers (retry proxy.golang.org blips).
COPY smoke-tests/retry-go-build.sh /usr/local/bin/retry-go-build
COPY smoke-tests/retry-go-install.sh /usr/local/bin/retry-go-install
RUN chmod +x /usr/local/bin/retry-go-build /usr/local/bin/retry-go-install

# Install the pinned simulator from the sockerless-cloud repository.
RUN GOBIN=/usr/local/bin retry-go-install github.com/e6qu/sockerless-cloud/simulator-gcp@${SOCKERLESS_CLOUD_VERSION}

# Copy source and build backend
WORKDIR /src
COPY api/ api/
COPY agent/ agent/
COPY backends/core/ backends/core/
COPY backends/gcp-common/ backends/gcp-common/
COPY backends/cloudrun/ backends/cloudrun/

RUN cd backends/cloudrun && retry-go-build /usr/local/bin/sockerless-backend-cloudrun ./cmd/sockerless-backend-cloudrun

COPY smoke-tests/run.sh /test/run.sh
RUN chmod +x /test/run.sh

ENV BACKEND=cloudrun
WORKDIR /test
ENTRYPOINT ["/test/run.sh"]
