FROM golang:1.25 AS builder

# The v0.2.0 release commit; go install of a subdirectory module needs a
# commit-ish, not the repository-root release tag.
ARG SOCKERLESS_CLOUD_VERSION=723736a8a233e0f3ccb3d6ce0c209a94bfc9afc2

# Build simulator
RUN GOBIN=/ go install -tags noui github.com/e6qu/sockerless-cloud/simulator-azure@${SOCKERLESS_CLOUD_VERSION}

# Build backend
WORKDIR /src
COPY api/ api/
COPY agent/ agent/
COPY backends/core/ backends/core/
COPY backends/azure-common/ backends/azure-common/
COPY backends/aca/ backends/aca/
RUN cd backends/aca && GOWORK=off go mod download && GOWORK=off go build -tags noui -o /sockerless-backend-aca ./cmd/sockerless-backend-aca

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /simulator-azure /usr/local/bin/simulator-azure
COPY --from=builder /sockerless-backend-aca /usr/local/bin/sockerless-backend-aca
COPY smoke-tests/gitlab/start-with-sim.sh /start-with-sim.sh
RUN chmod +x /start-with-sim.sh
ENTRYPOINT ["/start-with-sim.sh"]
