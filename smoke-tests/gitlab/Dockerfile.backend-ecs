FROM golang:1.26 AS builder

# The v0.2.0 release commit; go install of a subdirectory module needs a
# commit-ish, not the repository-root release tag.
ARG SOCKERLESS_CLOUD_VERSION=24dd57dfc0c684443ad7e0703f33652e6804ccb9

# Build simulator
RUN GOBIN=/ go install -tags noui github.com/e6qu/sockerless-cloud/simulator-aws@${SOCKERLESS_CLOUD_VERSION}

# Build backend
WORKDIR /src
COPY api/ api/
COPY agent/ agent/
COPY backends/core/ backends/core/
COPY backends/aws-common/ backends/aws-common/
COPY backends/ecs/ backends/ecs/
RUN cd backends/ecs && GOWORK=off go mod download && GOWORK=off go build -tags noui -o /sockerless-backend-ecs ./cmd/sockerless-backend-ecs

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /simulator-aws /usr/local/bin/simulator-aws
COPY --from=builder /sockerless-backend-ecs /usr/local/bin/sockerless-backend-ecs
COPY smoke-tests/gitlab/start-with-sim.sh /start-with-sim.sh
RUN chmod +x /start-with-sim.sh
ENTRYPOINT ["/start-with-sim.sh"]
