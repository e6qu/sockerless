# Snyk policy.
#
# Every entry below silences an infrastructure rule for Terraform that is never
# applied to a cloud. The .agents and .test-deps trees hold harness fixtures:
# they are applied against a local simulator and destroyed inside the same
# test run.
#
# Hardening them would be wrong, not merely unnecessary. A bucket that lives for
# the duration of one test against a simulator does not need MFA delete,
# versioning or a customer-managed key, and adding them would stop the fixture
# resembling the minimal configuration a consumer actually writes — which is the
# only thing it is there to prove.
#
# The ignores carry no expiry because the reason cannot expire: these files are
# fixtures by construction, not infrastructure awaiting hardening. Each is
# scoped to the fixture path, so the same rule is still reported anywhere else —
# terraform/modules/ holds the real deployable infrastructure and is deliberately
# not silenced here.
version: v1.25.0
ignore:
  SNYK-CC-AWS-415:
    - '.agents/shauth-provider-logout/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.test-deps/shauth/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
  SNYK-CC-AWS-421:
    - '.agents/shauth-provider-logout/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.test-deps/shauth/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
  SNYK-CC-TF-138:
    - '.agents/shauth-provider-logout/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.test-deps/shauth/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
  SNYK-CC-TF-56:
    - '.agents/shauth-provider-logout/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.agents/shauth-provider-logout/terraform/tests/fixtures/resource_derived_vpc_link/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.test-deps/shauth/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.test-deps/shauth/terraform/tests/fixtures/resource_derived_vpc_link/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
  SNYK-CC-TF-73:
    - '.agents/shauth-provider-logout/terraform/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.agents/shauth-provider-logout/terraform/tests/fixtures/resource_derived_vpc_link/main.tf > *':
        reason: Simulator/harness Terraform fixture, applied only against a local simulator and destroyed in-test.
    - '.test-deps/shauth/terraform/main.tf > *':
