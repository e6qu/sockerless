# Build outputs
.build/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
*.test
*.out
__debug_bin*
.gocache/

# Simulator binaries (built by `go build` in simulators/)
simulators/aws/simulator-aws
simulators/gcp/simulator-gcp
simulators/azure/simulator-azure

# Test-helper + tool binaries built by `go build ./...` in these dirs. The
# binaries are extensionless and named after their dir; every committed source
# file carries an extension (.go/.mod/.md), so ignore the extensionless build
# outputs and keep the sources. Covers current + future helpers without a
# per-binary line (the explicit list previously drifted out of date).
simulators/testdata/*/*
!simulators/testdata/*/*.*
tools/*/*
!tools/*/*.*

# Backend/agent built binaries (match only actual binary files, not cmd/ source dirs)
backends/*/sockerless-backend-*
agent/sockerless-agent
agent/cmd/sockerless-lambda-bootstrap/sockerless-lambda-bootstrap
frontends/docker/sockerless-docker-frontend
/sockerless-backend-ecs
/sockerless-backend-lambda

# CLI binary
cmd/sockerless/cli

# Terraform
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
!*.tfvars.example

# Runtime artifacts (generated by backends during test runs)
**/sockerless-registry.json

# Test outputs
tests/upstream/act/results/
tests/upstream/gitlab-ci-local/results/
tests/e2e-live-tests/logs/*
!tests/e2e-live-tests/logs/.gitignore
.firecracker-ci/
coverage.out
coverage.html

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Secrets / credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Node (for upstream gitlab-ci-local tests)
node_modules/

# UI monorepo
ui/node_modules/
ui/packages/*/node_modules/
ui/packages/*/dist/
ui/.turbo/
ui/packages/*/*.tsbuildinfo

# Embedded UI build artifacts
backends/memory/dist/
backends/ecs/dist/
backends/lambda/dist/
backends/cloudrun/dist/
backends/cloudrun-functions/dist/
backends/aca/dist/
backends/azure-functions/dist/
backends/docker/dist/
frontends/docker/dist/
simulators/aws/dist/
simulators/gcp/dist/
simulators/azure/dist/
cmd/sockerless-admin/dist/
cmd/sockerless-admin/sockerless-admin
cmd/sockerless-admin/admin
/admin
bleephub/dist/
bleephub/bleephub-server
bleephub/sdk-tests/bleephub-server
bleeplab/dist/
bleeplab/bleeplab

# Playwright
ui/packages/admin/test-results/
ui/packages/admin/playwright-report/
ui/packages/backend-*/test-results/
ui/packages/backend-*/playwright-report/
ui/packages/simulator-*/test-results/
ui/packages/simulator-*/playwright-report/
ui/packages/frontend-docker/test-results/
ui/packages/frontend-docker/playwright-report/
ui/packages/bleephub/test-results/
ui/packages/bleephub/playwright-report/

# Misc
*.log
tmp/

aws.sh
# Per-user Claude state is ignored, but project-local skills are checked-in;
# see docs/VIBE_CODING.md.
.claude/*
!.claude/skills/

# Runner harness runtime state — never committed (per-run runner config,
# unpacked binaries, log captures). Tokens never get persisted here even
# without this rule, but isolation keeps the dir from growing unboundedly.
tests/runners/github/.runner-*/
tests/runners/gitlab/.runner-*/
tests/runners/*/logs/
tests/runners/*/.runners/

# Runner-image build artifacts (cross-compiled binaries staged next to Dockerfile)
tests/runners/*/dockerfile-*/sockerless-backend-*
tests/runners/*/dockerfile-*/sockerless-gcf-bootstrap*
tests/runners/*/dockerfile-*/sockerless-cloudrun-bootstrap*

# Build outputs from the standardized per-app Makefiles (make build).
# Each app's Makefile writes its binary alongside the Makefile.
github-runner-dispatcher-aws/github-runner-dispatcher-aws
github-runner-dispatcher-gcp/github-runner-dispatcher-gcp
github-runner-dispatcher-azure/github-runner-dispatcher-azure
cmd/sockerless/sockerless
agent/sockerless-cloudrun-bootstrap
agent/sockerless-gcf-bootstrap
agent/sockerless-lambda-bootstrap
agent/sockerless-azf-bootstrap
agent/sockerless-azf-bootstrap-test
backends/*/dist/
simulators/*/dist/
.stack-pids/
temp/
agent/sockerless-cloudrun-bootstrap-aca-test-*
