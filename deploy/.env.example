# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Sockerless deployment recipe — environment schema.
#
# Copy this file to deploy/.env and fill in every value. deploy/provision.sh
# appends the values it derives (Shauth's bootstrap-apps JSON, the Azure
# federation clientId) to deploy/.env.generated — a second, git-ignored file
# compose reads alongside this one — so re-running provisioning never edits
# this file by hand. See deploy/README.md for the full runbook.
#
# Nothing in this file ships with real values. Secrets marked "generate a
# real value" must never be committed; deploy/.env and deploy/.env.generated
# are both git-ignored.

# ---------------------------------------------------------------------------
# Image pinning — registry mode (deploy/compose.yaml only; ignored by
# deploy/compose.build.yaml, which builds from source instead).
# ---------------------------------------------------------------------------

# REQUIRED. The short-SHA tag .github/workflows/publish-container-images.yml
# published for sockerless-admin / sockerless-simulator-{aws,gcp,azure}.
# Never "latest" — compose fails to parse without an explicit value.
SOCKERLESS_TAG=

# REQUIRED. The short-SHA tag e6qu/shauth published for the exact commit
# scripts/test-shauth-rps.sh pins (shauth_expected_commit). Keep these two
# values in sync: they name the same revision.
SHAUTH_TAG=0fda680cba96

# ---------------------------------------------------------------------------
# Source build mode (deploy/compose.build.yaml only).
# ---------------------------------------------------------------------------

# Path to a checkout of e6qu/shauth pinned to shauth_expected_commit from
# scripts/test-shauth-rps.sh (0fda680cba964e5768ed75a9c3e5b7230c418ca6),
# relative to deploy/. `.test-deps/shauth` is the same checkout CI already
# creates for the sso-browser job; fetch it the same way for local builds:
#   git clone https://github.com/e6qu/shauth ../.test-deps/shauth
#   git -C ../.test-deps/shauth checkout 0fda680cba964e5768ed75a9c3e5b7230c418ca6
SHAUTH_SOURCE_DIR=../.test-deps/shauth

# The revision compose reports to Shauth's release-identity validation and
# each console's monitoring page. Registry mode: set it equal to
# SOCKERLESS_TAG. Source-build mode: set it to `git rev-parse HEAD`.
APPLICATION_RELEASE_REVISION=

# ---------------------------------------------------------------------------
# Persistent origins.
#
# Every origin is served over TLS by the caddy service (deploy/Caddyfile) on
# one shared port, routed by hostname (SNI) — the ONLY service that
# publishes a host port. This is not a style choice: Sockerless Admin and
# each simulator console validate their own OpenID Connect issuer/public URL
# strictly (HTTPS, or plain HTTP only for the literal hostname "localhost"),
# so a persistent custom hostname over plain HTTP is rejected at startup by
# design — see cmd/sockerless-admin/shauth.go's `validate()` and
# simulators/ui-auth/auth.go's `isLoopbackHost`.
#
# The default values below use the public *.localtest.me DNS zone, which
# resolves any subdomain to 127.0.0.1 — exactly where caddy publishes its
# port on a single developer machine — combined with a Docker Compose
# network alias per hostname on the caddy service itself, so a browser on
# the host resolves e.g. shauth.localtest.me the same way a container on
# the compose network does (Docker's embedded DNS answers container lookups
# before they ever reach localtest.me's public records). caddy's `tls
# internal` directive issues each hostname a certificate from its own local
# certificate authority — see deploy/Caddyfile and deploy/README.md
# "Security" for what a real deployment (real DNS, real ACME certificates)
# changes and what it does not.
# ---------------------------------------------------------------------------

CADDY_PORT=8443

SHAUTH_HOSTNAME=shauth.localtest.me
SHAUTH_PUBLIC_URL=https://shauth.localtest.me:8443
# Ory Hydra's self-issuer. Shauth reverse-proxies every public Hydra OIDC
# endpoint (authorization, token, discovery, JWKS) through its own origin,
# so this is deliberately the same value as SHAUTH_PUBLIC_URL — Hydra never
# has a public origin of its own, only the internal admin/serve ports below.
HYDRA_PUBLIC_URL=https://shauth.localtest.me:8443
HYDRA_PUBLIC_PORT=4444
HYDRA_ADMIN_PORT=4445

ADMIN_HOSTNAME=admin.localtest.me
ADMIN_PUBLIC_URL=https://admin.localtest.me:8443

AWS_SIM_HOSTNAME=aws.localtest.me
AWS_SIM_PUBLIC_URL=https://aws.localtest.me:8443

GCP_SIM_HOSTNAME=gcp.localtest.me
GCP_SIM_PUBLIC_URL=https://gcp.localtest.me:8443

# The Azure Resource Manager / Microsoft Graph / Azure Monitor data plane —
# no browser reaches this origin directly; the console federates to it
# server-side over the private compose network (never through caddy) and
# then reads it browser-side through caddy (real ARM/Graph CORS,
# faithfully).
AZURE_CLOUD_SIM_HOSTNAME=azure-cloud.localtest.me

# The operator-facing Azure portal — the console half of the two-process
# split BUG-2640 required (real Microsoft Entra serves no CORS for
# client_credentials, so the federation exchange must be server-side and
# same-origin with the console, not with Azure Resource Manager).
AZURE_CONSOLE_SIM_HOSTNAME=azure-console.localtest.me
AZURE_CONSOLE_SIM_PUBLIC_URL=https://azure-console.localtest.me:8443

POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# Secrets — generate a real value for every line below
# (`openssl rand -hex 32` / `openssl rand -base64 48`). Never commit
# deploy/.env; it is git-ignored.
# ---------------------------------------------------------------------------

# deploy/provision.sh derives HYDRA_DSN and SHAUTH_DATABASE_URL from this
# password into deploy/.env.generated — do not set those two by hand.
POSTGRES_PASSWORD=
HYDRA_SYSTEM_SECRET=
# Also read by provision.sh, which looks this account up in the Shauth
# identity store to provision the Azure federated identity credential — keep
# it equal to compose's own SHAUTH_BOOTSTRAP_ADMIN_EMAIL default if you
# change it here.
SHAUTH_BOOTSTRAP_ADMIN_EMAIL=admin@localhost.test
SHAUTH_BOOTSTRAP_ADMIN_PASSWORD=
# The signing key every relying party (Admin + the three consoles) uses for
# its own local session cookie — distinct from Shauth's own session store.
SESSION_SECRET=

# One Hydra confidential-client secret per relying party. provision.sh reads
# these to build SHAUTH_BOOTSTRAP_APPS_JSON; they must match the
# SOCKERLESS_ADMIN_SHAUTH_CLIENT_SECRET / SIM_UI_OIDC_CLIENT_SECRET values
# compose passes to each service (deploy/compose.yaml wires them from these
# same variables — nothing else to keep in sync by hand).
ADMIN_OIDC_CLIENT_SECRET=
AWS_OIDC_CLIENT_SECRET=
GCP_OIDC_CLIENT_SECRET=
AZURE_OIDC_CLIENT_SECRET=

# Every origin above is HTTPS through caddy by default, so cookies are
# secure by default (SHAUTH_INSECURE_COOKIES unset = false in every compose
# service). Only set this to true if you have reconfigured deploy/Caddyfile
# to serve plain HTTP over a literal "localhost" hostname instead — see
# cmd/sockerless-admin/shauth.go's `validate()` for exactly what that
# requires.
SHAUTH_INSECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Upstream GitHub OAuth application (Shauth's upstream sign-in option).
# Shauth requires all four non-empty to boot even when GitHub sign-in is
# unused — the placeholders below let the stack boot and the smoke test
# exercise Shauth's own local admin sign-in; replace them with a real GitHub
# OAuth App's client id/secret and your organization's team slugs to enable
# GitHub sign-in for operators.
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=deploy-placeholder-client-id
GITHUB_CLIENT_SECRET=deploy-placeholder-client-secret
GITHUB_DEVELOPER_TEAM=your-org/developers
GITHUB_ADMIN_TEAM=your-org/admins

# ---------------------------------------------------------------------------
# Federation resources — provision.sh writes the values it mints for these
# into deploy/.env.generated. Leave blank here; do not hand-edit
# .env.generated.
# ---------------------------------------------------------------------------

# AWS: the IAM role the AWS console assumes via AssumeRoleWithWebIdentity
# after federating the operator's Shauth assertion through the IAM OpenID
# Connect provider provision.sh creates for the Shauth issuer.
AWS_FEDERATION_ROLE_ARN=arn:aws:iam::123456789012:role/console-federation-role

# GCP: the workforce pool provider resource name the Google Cloud console
# federates through.
GCP_WORKFORCE_PROVIDER=//iam.googleapis.com/locations/global/workforcePools/sockerless-console/providers/sso

# Azure: the tenant path segment Microsoft Entra Workload Identity
# Federation token requests use (any stable GUID-shaped value — the
# simulator does not validate it against a real Microsoft Entra tenant,
# exactly like the ARM_TENANT_ID the simulator's own Terraform docs use).
AZURE_FEDERATION_TENANT=11111111-1111-1111-1111-111111111111
