FROM golang:1.25-bookworm

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
    TF_IN_AUTOMATION=1 \
    AWS_PAGER= \
    AZURE_CORE_NO_COLOR=true \
    PATH="/opt/google-cloud-sdk/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        debian-archive-keyring \
        debian-keyring \
        dnsmasq-base \
        docker.io \
        e2fsprogs \
        git \
        gnupg \
        iproute2 \
        iputils-ping \
        jq \
        lsb-release \
        make \
        nftables \
        openssh-client \
        procps \
        squashfs-tools \
        sudo \
        util-linux \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends apt-transport-https; \
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg; \
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' > /etc/apt/sources.list.d/caddy-stable.list; \
    chmod o+r /usr/share/keyrings/caddy-stable-archive-keyring.gpg /etc/apt/sources.list.d/caddy-stable.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends caddy; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64|x86_64) tf_arch="amd64" ;; \
      arm64|aarch64) tf_arch="arm64" ;; \
      *) echo "unsupported Terraform architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://releases.hashicorp.com/terraform/1.8.5/terraform_1.8.5_linux_${tf_arch}.zip" -o /tmp/terraform.zip; \
    unzip /tmp/terraform.zip -d /usr/local/bin; \
    rm /tmp/terraform.zip

RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64|x86_64) aws_arch="x86_64" ;; \
      arm64|aarch64) aws_arch="aarch64" ;; \
      *) echo "unsupported AWS CLI architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${aws_arch}.zip" -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install; \
    rm -rf /tmp/aws /tmp/awscliv2.zip

RUN set -eux; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64|x86_64) gcloud_arch="x86_64" ;; \
      arm64|aarch64) gcloud_arch="arm" ;; \
      *) echo "unsupported Google Cloud CLI architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-${gcloud_arch}.tar.gz" \
      | tar -xz -C /opt; \
    /opt/google-cloud-sdk/install.sh \
      --quiet \
      --path-update=false \
      --command-completion=false \
      --usage-reporting=false

RUN curl -fsSL https://aka.ms/InstallAzureCLIDeb -o /tmp/install-azure-cli.sh \
    && bash /tmp/install-azure-cli.sh \
    && rm /tmp/install-azure-cli.sh

RUN mkdir -p /tmp/sockerless-home \
    && chmod 1777 /tmp/sockerless-home

COPY scripts/install-firecracker.sh /tmp/install-firecracker.sh
RUN bash /tmp/install-firecracker.sh \
    && rm /tmp/install-firecracker.sh

COPY simulators/docker-test-entrypoint.sh /usr/local/bin/sockerless-simulator-test-entrypoint

ENTRYPOINT ["bash", "/usr/local/bin/sockerless-simulator-test-entrypoint"]
WORKDIR /src
